# Local extracts of Ubuntu packages (when apt install is unavailable)
# e.g. libmodbus, nlohmann-json3-dev
.deps/

# Downloaded Debian packages
*.deb

# Build directories
build/
build-hilscher/
cmake-build-*/
out/

# Compiled objects and libraries
*.o
*.obj
*.so
*.a

# Debug files
*.dSYM/
core
core.*

# IDE/editor
.vscode/
.idea/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
Makefile

# Logs
*.log

# Temporary files
*.tmp
*.swp
*~

# Local cifX / Hilscher build leftovers (never commit)
build-cifx/

# Proprietary Hilscher firmware / licenses (never commit)
*.nxf
*.nxi
*.nxo
*NXLIC*

# OS files
.DS_Store
Thumbs.db

          ],
          "commands": [
            {
              "command": "start",
              "outputByteOffset": 0,
              "bitOffset": 0,
              "valueType": "Bool"
            }
          ],
          "state": {
            "mapped": true,
            "inputByteOffset": 2,
            "bitOffset": 0,
            "valueType": "Bool"
          },
          "fault": {
            "mapped": true,
            "inputByteOffset": 2,
            "bitOffset": 1,
            "valueType": "Bool"
          }
        }
      ]
    }
  ]

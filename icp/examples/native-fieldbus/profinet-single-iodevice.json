{
  "schema": "virtual-factory.icp.config",
  "version": 1,
  "name": "hilscher-profinet-single-iodevice-example",
  "adapters": [
    {
      "adapterId": "pn-controller-1",
      "protocol": "profinet",
      "enabled": true,
      "description": "Example: one PROFINET controller + one IO-Device (placeholders only)",
      "connection": {
        "boardId": "cifx0",
        "channel": 0,
        "interfaceName": "eth-pn",
        "stationName": "icp-pn-controller",
        "configArtifactPath": "/opt/cifx/config/profinet/config.nxd",
        "expectedFirmwareName": "PROFINET",
        "pollTimeoutMs": 1000
